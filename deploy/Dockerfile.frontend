# NX-360 BMS — frontend (React build servido pelo Nginx)
# Multi-stage: estágio 1 compila o React, estágio 2 serve estático

# ---------- 1) Builder ----------
FROM node:20-alpine AS builder

WORKDIR /app

# URL pública do backend DEVE ser injetada no build (CRA bakes em tempo de compilação)
# Em produção isso é a URL que o navegador do usuário vai acessar — ex.: https://bms.suaempresa.com
ARG REACT_APP_BACKEND_URL
ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL

# Dependências primeiro (cache de layer)
# yarn.lock é opcional (o export do Emergent não inclui)
COPY frontend/package.json frontend/yarn.lock* /app/
# Remove plugins de dev do Emergent (só usados no preview; baixados de CDN privada)
RUN node -e "const f='package.json',p=require('./'+f);for(const k of Object.keys(p.devDependencies||{}))if(k.startsWith('@emergentbase/'))delete p.devDependencies[k];require('fs').writeFileSync(f,JSON.stringify(p,null,2))"
RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile --network-timeout 600000; \
    else yarn install --network-timeout 600000; fi

# Código e build
COPY frontend /app
# Garante que nenhum .env do preview do Emergent sobrescreva a URL do servidor
RUN rm -f /app/.env /app/.env.local /app/.env.production \
    && printf "REACT_APP_BACKEND_URL=%s\nGENERATE_SOURCEMAP=false\n" "$REACT_APP_BACKEND_URL" > /app/.env
ENV NODE_OPTIONS=--max-old-space-size=1536
RUN yarn build

# ---------- 2) Nginx ----------
FROM nginx:1.27-alpine

# SPA fallback — qualquer rota do React cai no index.html
RUN rm -f /etc/nginx/conf.d/default.conf \
    && printf 'server {\n  listen 80 default_server;\n  server_name _;\n  root /usr/share/nginx/html;\n  index index.html;\n  location /static/ { add_header Cache-Control "public, max-age=31536000, immutable"; }\n  location / { try_files $uri $uri/ /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf

# Copia o build estático
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://localhost/ > /dev/null || exit 1
